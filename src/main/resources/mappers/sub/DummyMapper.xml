<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seanet.demo.mappers.sub.DummyMapper">

    <select id="findLatestTelegraphOrder" resultType="java.lang.Integer">
        SELECT TOP 1 _order
        FROM TB_Telegraph
        ORDER BY SaveTime DESC
    </select>

